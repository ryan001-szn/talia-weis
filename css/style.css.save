
:root {
  --black: #080808;
  --dark: #111111;
  --card: #171717;
  --cream: #f4eee7;
  --muted: #aaa39c;
  --gold: #c9a66b;
  --wine: #651c32;
  --line: rgba(255,255,255,0.1);
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  background: var(--black);
  color: var(--cream);
  font-family: 'Inter', sans-serif;
  overflow-x: hidden;
}

a {
  color: inherit;
  text-decoration: none;
}

button {
  font-family: inherit;
}

.eyebrow {
  color: var(--gold);
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 3px;
  text-transform: uppercase;
}

/* AGE GATE */

.age-gate {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 25px;
  background:
    linear-gradient(rgba(0,0,0,.82), rgba(0,0,0,.94)),
    radial-gradient(circle at center, #481525, #050505 65%);
}

.age-card {
  width: 100%;
  max-width: 460px;
  padding: 45px 30px;
  text-align: center;
  background: rgba(20,20,20,.88);
  border: 1px solid var(--line);
  backdrop-filter: blur(20px);
  border-radius: 18px;
}

.logo-mark {
  width: 60px;
  height: 60px;
  margin: 0 auto 25px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--gold);
  border-radius: 50%;
  color: var(--gold);
  font-family: 'Cormorant Garamond', serif;
  font-size: 22px;
}

.age-card h2 {
  font-family: 'Cormorant Garamond', serif;
  font-size: 38px;
  margin-bottom: 15px;
}

.age-card p {
  color: var(--muted);
  line-height: 1.7;
  font-size: 14px;
}

.age-buttons {
  display: flex;
  gap: 12px;
  margin-top: 30px;
}

.age-buttons button {
  flex: 1;
  padding: 14px;
  border-radius: 8px;
  cursor: pointer;
  border: 1px solid var(--line);
}

.age-buttons button:first-child {
  background: var(--gold);
  color: #080808;
  border: none;
}

.age-buttons button:last-child {
  background: transparent;
  color: var(--cream);
}

/* NAVBAR */

.navbar {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 25px 6%;
}

.logo {
  font-size: 16px;
  letter-spacing: 4px;
  font-weight: 700;
}

.logo span {
  color: var(--gold);
  font-weight: 400;
}

.navbar nav {
  display: flex;
  gap: 35px;
}

.navbar nav a {
  color: #d6d0c9;
  font-size: 13px;
  transition: .3s;
}

.navbar nav a:hover {
  color: var(--gold);
}

.join-button {
  padding: 11px 21px;
  border: 1px solid rgba(201,166,107,.6);
  border-radius: 6px;
  font-size: 12px;
  transition: .3s;
}

.join-button:hover {
  background: var(--gold);
  color: #080808;
}

/* HERO */

.hero {
  position: relative;
  min-height: 100vh;
  display: flex;
  align-items: center;
  padding: 120px 8% 70px;
  overflow: hidden;

  background:
    linear-gradient(90deg,
      rgba(0,0,0,.95) 0%,
      rgba(0,0,0,.72) 45%,
      rgba(0,0,0,.25) 100%),
    radial-gradient(
      circle at 75% 40%,
      rgba(101,28,50,.7),
      transparent 40%
    ),
    linear-gradient(135deg, #111 0%, #090909 55%, #240d16 100%);
}

.hero::after {
  content: "";
  position: absolute;
  right: -15%;
  top: 5%;
  width: 55%;
  height: 90%;
  border-radius: 50%;
  background:
    radial-gradient(
      ellipse,
      rgba(201,166,107,.18),
      transparent 60%
    );
  filter: blur(40px);
}

.hero-content {
  position: relative;
  z-index: 2;
  max-width: 650px;
}

.hero h1 {
  margin-top: 18px;
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(65px, 9vw, 125px);
  line-height: .78;
  font-weight: 500;
  letter-spacing: -4px;
}

.hero h1 em {
  color: var(--gold);
  font-style: italic;
  font-weight: 400;
}

.hero-description {
  max-width: 470px;
  margin-top: 35px;
  color: #bcb5ae;
  line-height: 1.8;
  font-size: 15px;
}

.hero-buttons {
  display: flex;
  align-items: center;
  gap: 28px;
  margin-top: 35px;
}

.primary-button {
  display: inline-block;
  padding: 16px 25px;
  background: var(--gold);
  color: #080808;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: .5px;
  border-radius: 5px;
  transition: .3s;
}

.primary-button:hover {
  transform: translateY(-2px);
  box-shadow: 0 12px 35px rgba(201,166,107,.2);
}

.explore-link {
  font-size: 13px;
  color: #ddd;
}

.hero-bottom {
  position: absolute;
  bottom: 25px;
  left: 8%;
  right: 8%;
  z-index: 3;
  display: flex;
  justify-content: space-between;
  color: #777;
  font-size: 9px;
  letter-spacing: 2px;
}

/* SECTIONS */

.section {
  padding: 110px 7%;
}

.section-title {
  display: flex;
  justify-content: space-between;
  gap: 40px;
  align-items: end;
  margin
